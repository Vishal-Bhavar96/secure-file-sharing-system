# SecureShare Environment & SMTP Email Configuration

PROJECT_NAME="Secure File-Sharing System"
SECRET_KEY="dev_secret_key_change_in_production_1234567890!"
DATABASE_URL="sqlite:///./secure_sharing.db"

# Real Email Delivery (Gmail SMTP Configuration)
# 1. Enter your Gmail address in SMTP_USER and EMAILS_FROM_EMAIL
# 2. Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
# 3. Enter the 16-character App Password in SMTP_PASSWORD
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME="SecureShare Vault Security"
